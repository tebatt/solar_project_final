# Copy to your own environment (do not commit real values).

# Required: at least 32 random characters.
JWT_SECRET_KEY=
JWT_ISSUER=utu-api
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional: defaults to backend/solar_test.db; set this URL to switch databases.
DATABASE_URL=

# Comma-separated frontend origins allowed to call the API.
UTU_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional, development-only listing of pending companies for homepage preview.
# Requires VITE_COMPANY_PREVIEW_ENABLED=true in the frontend as well.
APP_ENV=development
UTU_COMPANY_PREVIEW_ENABLED=false
# Development-only preview of clearly marked, unverified seed reviews.
UTU_DEMO_REVIEW_PREVIEW_ENABLED=false

# Password for demo accounts created by seed.py (demo databases only).
UTU_DEMO_PASSWORD=

# Optional admin identity for startup bootstrap and seed_real_companies_test.py.
# A fresh local/test database defaults to admin@solar.iq / adminpassword.
# Set a private password of at least 10 characters for production or staging.
UTU_ADMIN_EMAIL=admin@solar.iq
UTU_ADMIN_PASSWORD=
UTU_ADMIN_NAME=Platform Administrator

# Company password-reset email (optional).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
PUBLIC_APP_URL=http://127.0.0.1:5173
