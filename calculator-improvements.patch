+export function withApplianceKind(appliance: Appliance, kind: string): Appliance {
+  const entry = findApplianceDefaults(kind);
+  if (!entry) return appliance;
+  return {
+    ...appliance,
+    kind: entry.id,
+    watts: entry.watts,
+    hours: entry.hours,
+    icon: entry.icon,
+    name: { ...entry.name },
+    units: Math.max(1, appliance.units),
+    nameEdited: false,
+  };
