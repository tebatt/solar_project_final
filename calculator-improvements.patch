+
+/** Offered, in order, by the "add another device" control. */
+export const extraAppliances: Appliance[] = applianceCatalog
+  .filter((entry) => !(entry.id in DEMO_UNITS))
+  .map((entry) => fromCatalog(entry, 1));
+
+/**
